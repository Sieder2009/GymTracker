# Ironpeak Fitness — Flutter app, lives entirely under mobile/.
# Dart/Android/iOS/Windows build artifacts are ignored there via
# mobile/.gitignore; this file only covers things that can show up at the
# repo root (editor/OS cruft, Claude Code's local state).

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Leftovers from an aborted `git apply`/merge, not something to ever commit
*.orig
*.rej

# Claude Code
.claude/

# Local reference copies of other projects (each has its own .git)
/1/
/beispiel app/
